<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane styleClass="main-status-bar" hgap="12" xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints percentWidth="60" minWidth="0" />
    <ColumnConstraints percentWidth="40" minWidth="0" />
  </columnConstraints>
  <HBox alignment="CENTER_LEFT" spacing="4" minWidth="0">
    <Label text="Local data ·" minWidth="-Infinity" />
    <Label fx:id="saveLocationStatus" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
  </HBox>
  <Label text="Use the contact number in commands" styleClass="status-guidance" wrapText="true"
         minWidth="0" minHeight="-Infinity" maxWidth="Infinity" alignment="CENTER_RIGHT"
         textAlignment="RIGHT" GridPane.columnIndex="1" />
</GridPane>
