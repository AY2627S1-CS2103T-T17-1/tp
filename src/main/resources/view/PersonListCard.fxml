<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" spacing="8" minWidth="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="14" bottom="12" left="14" />
  </padding>
  <HBox spacing="8" alignment="TOP_LEFT">
    <Label fx:id="id" styleClass="cell_big_label" minWidth="-Infinity" />
    <Label fx:id="name" styleClass="cell_big_label" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="role" styleClass="contact-role" minWidth="-Infinity" />
  </HBox>
  <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" />
  <VBox fx:id="details" spacing="8" styleClass="contact-details" visible="false" managed="false">
    <Label fx:id="email" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <Label fx:id="address" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <Label fx:id="subject" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <Label fx:id="level" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <Label fx:id="note" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <Label fx:id="links" styleClass="cell_small_label" wrapText="true" minWidth="0" />
    <ScrollPane fx:id="tagScroller" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                maxHeight="96" minHeight="0" pannable="true">
      <content>
        <FlowPane fx:id="tags" />
      </content>
    </ScrollPane>
  </VBox>
</VBox>
